VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only: Supabase Edge Function secret for `extract-pdf-text` (ApyHub).
# Set it with `supabase secrets set APY_TOKEN=...`; never prefix it with VITE_.
APY_TOKEN=

# Knock in-app notifications (public client key + feed channel id only).
VITE_KNOCK_PUBLIC_API_KEY=
VITE_KNOCK_FEED_CHANNEL_ID=
