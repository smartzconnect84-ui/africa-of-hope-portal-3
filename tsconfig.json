{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    // TypeScript 6 removed the `baseUrl` requirement for `paths`; alias targets
    // resolve relative to this file. Keeping `baseUrl` fails the typecheck
    // script with TS5101, so it is intentionally omitted.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": [
    "node_modules",
    "src/components/ui" // Add the directory you want to skip here
  ]
}
