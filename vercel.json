{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/((?!api|assets|logo|icons|og-card.svg|manifest.webmanifest|sitemap.xml|robots.txt|llms.txt|blog-slugs.txt).*)", "destination": "/index.html" }],
  "redirects": [{ "source": "/:path*", "has": [{ "type": "host", "value": "www.africaofhopelr.org" }], "destination": "https://africaofhopelr.org/:path*", "permanent": true }],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    },
    {
      "source": "/og-card.svg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
